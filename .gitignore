# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results

# next.js
/.next/
/out/
.turbo

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
*.pem

# logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# secrets and environment files (the committed template is .env.example)
.env
.env.*
!.env.example

# docker
docker-compose.override.yml
compose.override.yaml

# editors
.idea
.vscode/*
!.vscode/extensions.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
