# Copy to .env.local for development, or provide these as real environment
# variables in production. Never commit a filled-in .env file.

# Absolute origin of the deployment. Used for canonical URLs, sitemap entries
# and social metadata. Must be a valid URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Port the production server listens on (defaults to 3000).
# PORT=3000

# The wallet is stored in the browser and the payment gateway is simulated,
# so there are no API keys or database credentials in this project.
